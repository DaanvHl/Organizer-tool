# Copy this file to .env and fill in your values. Never share your .env file!

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your server ID (right-click server icon -> Copy Server ID, needs Developer Mode on).
# Makes slash commands appear instantly. Leave empty to register globally (can take up to an hour).
GUILD_ID=

# Channels where /event commands may be used, comma-separated (right-click channel -> Copy Channel ID).
# Leave empty to allow them everywhere. Event channels created by the bot always allow commands.
ALLOWED_CHANNEL_IDS=

TIMEZONE=Europe/Amsterdam
REMINDER_MINUTES=15
AUTO_CLEANUP_HOURS=3
EVENTS_CATEGORY=Events

# Where the SQLite database is stored. On Railway, use a volume path like /data/events.db
DATABASE_PATH=events.db
